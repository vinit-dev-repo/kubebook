#!/bin/bash
# First-boot script shared by the three vm2 fixtures: it installs the machine's SSH host key and nothing else.
# The host key is generated by Terraform (one tls_private_key per machine) and installed here first, so a chapter can
# verify the host key out of band from the fixture's `cp_host_key` / `worker_host_key` outputs instead of trusting the
# first thing that answers on port 22. NO container runtime and NO Kubernetes package is installed here: chapter 32
# teaches the reader to install those step by step, on a stock Ubuntu.
set -e
install -m 600 /dev/null /etc/ssh/ssh_host_ed25519_key
cat > /etc/ssh/ssh_host_ed25519_key <<'KUBEBOOK_HOST_KEY'
${host_key_private}
KUBEBOOK_HOST_KEY
printf '%s\n' '${host_key_public}' > /etc/ssh/ssh_host_ed25519_key.pub
chmod 644 /etc/ssh/ssh_host_ed25519_key.pub
systemctl restart ssh || systemctl restart sshd
# a marker the chapter can wait for before it connects (the host key is in place once this file exists)
touch /var/lib/kubebook-ready
